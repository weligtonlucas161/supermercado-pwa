# ============================================================================
# SuperPWA OpSys - Variáveis de ambiente
# Copie para `.env` e preencha. O arquivo `.env` NÃO é versionado.
# ============================================================================

# ----------------------------------------------------------------------------
# BANCO DE DADOS (Supabase / PostgREST) — OBRIGATÓRIO
# URL do projeto e anon/publishable key.
# Nenhuma credencial é embarcada no bundle: sem estas variáveis (ou sem
# configuração manual pela tela de importação) o app opera em modo local.
# ----------------------------------------------------------------------------
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="SUA_SUPABASE_ANON_KEY"

# ----------------------------------------------------------------------------
# CHAVE MESTRA DE CIFRAGEM (OBRIGATÓRIO)
# Chave usada para cifrar/decifrar os campos sensíveis (AES-256).
# O valor legado hardcoded foi removido do código por segurança.
# Sem esta variável configurada, a cifragem é recusada e campos protegidos
# não poderão ser gravados. Gere com: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
# ----------------------------------------------------------------------------
VITE_ENCRYPTION_KEY="SUA_CHAVE_MESTRA_AES_256"

# ----------------------------------------------------------------------------
# PEPPER DO HASH DETERMINÍSTICO DE EAN (OBRIGATÓRIO/RECOMENDADO)
# Usado para gerar o HMAC-SHA256 do EAN para indexação e deduplicação atômica.
# ----------------------------------------------------------------------------
VITE_EAN_HASH_PEPPER="SEU_PEPPER_DE_HASH"

# ----------------------------------------------------------------------------
# OUTROS
# ----------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
